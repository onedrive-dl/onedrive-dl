# Public *folder* sharing link from SharePoint. Keep your personal .env private.
SHAREPOINT_URL=https://tenant-my.sharepoint.com/:f:/g/personal/example/EXAMPLE?e=EXAMPLE

# Relative paths are resolved from the directory that contains .env.
DOWNLOAD_DIR=Download

# true = exact mirror; false = download/update only, never remove local files.
MIRROR_DELETE=true

# Network timeout for each SharePoint request.
TIMEOUT_SECONDS=90
